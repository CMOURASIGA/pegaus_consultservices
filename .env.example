# Public, safe for the browser. Do not place privileged keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Configure only when a backend-managed operation requires it.
# Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

APP_VERSION=development
LOG_LEVEL=info

# AI Router safety defaults. Provider/model catalog is supplied server-side.
# Paid routing and paid fallback require explicit runtime opt-in.
AI_ROUTER_TIMEOUT_MS=30000
AI_ROUTER_RETRIES_PER_MODEL=0
AI_ROUTER_FALLBACK_ENABLED=false
AI_ROUTER_FALLBACK_MAX_MODELS=1
AI_ROUTER_FALLBACK_ALLOW_PAID=false
